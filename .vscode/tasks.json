{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: FastAPI (uvicorn)",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "uvicorn",
        "main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Frontend: HTTP Server",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "5500"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
